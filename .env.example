# Copy to .env and edit. Values here override anything already in the shell.

# --- core --------------------------------------------------------------------
DEBUG=true
# Required when DEBUG=false. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Comma-separated; required when DEBUG=false.
ALLOWED_HOSTS=
# Comma-separated full origins, e.g. https://dash.excellar.finance
CSRF_TRUSTED_ORIGINS=

# --- database ----------------------------------------------------------------
# Omit for SQLite at data/excellar.sqlite3 (the zero-setup default). Point this
# at the existing navdash Postgres to keep every NAV snapshot already recorded.
# DATABASE_URL=postgres://user:pass@localhost:5432/navdash

# --- CallSpread / STS Digital ------------------------------------------------
# With no STS keys the dashboard serves its demo book instead of failing.
STS_CLIENT_ID=
STS_CLIENT_SECRET=
# Blank = production endpoints.
STS_API_URL=
STS_AUTH_URL=
STS_AUDIENCE=
# Force the synthetic book even when credentials are present.
CALLSPREAD_DEMO=false

# --- NAV ---------------------------------------------------------------------
# Custody balances.
BITGO_ACCESS_TOKEN=
BITGO_ENTERPRISE_ID=
# Per-XLtoken override, e.g. BITGO_ENTERPRISE_ID_xlBTC=...

# Per-XLtoken exchange keys, e.g. XLBTC_BINANCE_API_KEY / XLETH_HL_WALLET_ADDRESS
# and XLBTC_DERIBIT_CLIENT_ID. See portal/settings.py for the full list.

# On-chain RPCs — the env var names come from config/config.yaml (Aave, Spark).

# Google Sheets export for the daily NAV report. Blank = data/nav_report/ in
# this project (credentialsNAV.json, token_summary.pickle, the sheet-id cache).
# GOOGLE_CREDENTIALS_FILE=
# NAV_REPORT_TOKEN_FILE=
# NAV_REPORT_SHEET_ID_FILE=

# Slack incoming webhook for the daily NAV reconciliation post. Blank = the
# report still goes to Google Sheets, just isn't announced anywhere.
SLACK_WEBHOOK_URL=

# Scheduler (NAV periodic snapshots + daily report).
REDIS_URL=redis://localhost:6379/0

# --- sessions ----------------------------------------------------------------
SESSION_COOKIE_AGE=43200
SESSION_EXPIRE_AT_BROWSER_CLOSE=false

# --- gateway timeouts (seconds) ----------------------------------------------
GATEWAY_CONNECT_TIMEOUT=3
GATEWAY_READ_TIMEOUT=60
GATEWAY_PROBE_TIMEOUT=2

# --- misc --------------------------------------------------------------------
PORTAL_TIME_ZONE=UTC